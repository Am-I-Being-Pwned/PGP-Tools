{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build", "build:wasm"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**", ".output/**"],
      "inputs": ["$TURBO_DEFAULT$", "!tests/**", "!shots/**"]
    },
    "build:wasm": {
      "inputs": [
        "gpg-wasm/src/**",
        "gpg-wasm/Cargo.toml",
        "gpg-wasm/Cargo.lock"
      ],
      "outputs": ["gpg-wasm/pkg/**"]
    },
    "dev": {
      "dependsOn": ["^dev", "build:wasm"],
      "cache": false,
      "persistent": false
    },
    "@amibeingpwned/pgp#dev": {
      "dependsOn": ["build:wasm"],
      "cache": false,
      "persistent": true
    },
    "@amibeingpwned/pgp#typecheck": {
      "dependsOn": ["^topo", "^build", "build:wasm"],
      "outputs": []
    },
    "format": {
      "outputs": [".cache/.prettiercache"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^topo", "^build", "build:wasm"],
      "outputs": [".cache/.eslintcache"]
    },
    "lint:fix": {
      "dependsOn": ["^topo", "^build", "build:wasm"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^topo", "^build", "build:wasm"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!tests/e2e/**",
        "!tests/capture/**",
        "!playwright.config.ts",
        "!playwright.capture.config.ts",
        "!shots/**"
      ]
    },
    "@amibeingpwned/pgp#test:rust": {
      "inputs": [
        "gpg-wasm/src/**",
        "gpg-wasm/Cargo.toml",
        "gpg-wasm/Cargo.lock",
        "package.json"
      ],
      "outputs": []
    },
    "@amibeingpwned/pgp#badges:check": {
      "dependsOn": ["test"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/README.md"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "env": ["CI", "HEADED"],
      "outputs": ["test-results/**", "playwright-report/**"]
    },
    "typecheck": {
      "dependsOn": ["^topo", "^build", "build:wasm"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "zip": {
      "dependsOn": ["build"],
      "outputs": [".output/*.zip"]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "ui-add": {
      "cache": false,
      "interactive": true
    }
  }
}
