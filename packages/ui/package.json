  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./alert": "./src/alert.tsx",
    "./button": "./src/button.tsx",
    "./calendar": "./src/calendar.tsx",
    "./checkbox": "./src/checkbox.tsx",
