#!/bin/sh
#
# Refuse a push to main whose README badges don't match the code being
# pushed.
#
# WHY A HOOK AND NOT JUST CI. CI already runs `badges:check`, so a stale
# badge is caught either way -- but only after a red build on main, which
# then needs a second "chore: update badges" commit to clear. That has
# happened repeatedly. Catching it here costs ~30s on a main push and
# turns a broken build plus a follow-up commit into an amend.
#
# It CHECKS rather than regenerates: a hook cannot add files to the push
# already in flight, so silently rewriting README.md would leave the
# working tree dirty and push the stale version anyway.
#
# Only main. Feature branches push freely -- the badges are a claim made
# on the default branch, and CI is the backstop before a merge lands.
#
# Escape hatches: `git push --no-verify`, or SKIP_BADGE_CHECK=1.

[ -n "$SKIP_BADGE_CHECK" ] && exit 0

root=$(git rev-parse --show-toplevel) || exit 0
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

pushing_main=0
# stdin: <local ref> <local sha> <remote ref> <remote sha>, one per ref.
while read -r _local_ref local_sha remote_ref _remote_sha; do
  # A deletion carries an all-zero local sha and no tree to check.
  [ "$local_sha" = "$zero" ] && continue
  case "$remote_ref" in
    refs/heads/main) pushing_main=1 ;;
  esac
done

[ "$pushing_main" -eq 1 ] || exit 0

echo "pre-push: verifying README badges against apps/pgp (main only)..."

cd "$root" || exit 0

# Through turbo: the unit suite is the expensive half, and turbo restores
# its coverage output when nothing that feeds it has changed. In practice
# that costs ~20s the first time after a source change and a few
# milliseconds on every push after it.
out=$(pnpm badges:check 2>&1)
status=$?

if [ "$status" -eq 0 ]; then
  echo "pre-push: README badges are current."
  exit 0
fi

# A non-zero exit is not automatically drift: no pnpm, a half-finished
# install, or a genuinely failing unit suite all land here too. Only the
# script's own drift message should block a push -- a broken local
# toolchain is CI's problem, and refusing to push over it would just
# teach everyone to reach for --no-verify.
if ! printf '%s' "$out" | grep -q "badges are out of date"; then
  echo "pre-push: badge check could not run; pushing anyway. Tail:" >&2
  printf '%s\n' "$out" | tail -15 >&2
  exit 0
fi

cat >&2 <<'MSG'

  ✗ README badges are out of date, and CI will fail on this push.

    Regenerate and fold them into the commit you are pushing:

        pnpm --filter @amibeingpwned/pgp badges
        git add README.md && git commit --amend --no-edit

    Or push anyway with --no-verify (CI will still flag it).

MSG
exit 1
