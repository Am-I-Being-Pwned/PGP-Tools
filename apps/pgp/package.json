{
  "name": "@amibeingpwned/pgp",
  "description": "PGP Tools - Encrypt, Decrypt & Sign",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build:wasm": "cd gpg-wasm && wasm-pack build --target web --release",
    "build": "pnpm build:wasm && wxt build && node scripts/audit-invariants.mjs && node scripts/audit-network.mjs",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "test": "vitest run --coverage",
    "test:rust": "cd gpg-wasm && cargo test --release --lib",
    "coverage": "vitest run --coverage",
    "badges": "node scripts/update-badges.mjs",
    "badges:check": "node scripts/update-badges.mjs --check",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:build": "pnpm build && playwright test",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@amibeingpwned/ui": "workspace:*",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "focus-trap": "^8.2.2",
    "lucide-react": "^1.33.0",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "sonner": "^2.0.8",
    "tabbable": "^6.5.0"
  },
  "devDependencies": {
    "@amibeingpwned/eslint-config": "workspace:*",
    "@amibeingpwned/prettier-config": "workspace:*",
    "@amibeingpwned/tailwind-config": "workspace:*",
    "@amibeingpwned/tsconfig": "workspace:*",
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "catalog:",
    "@types/chrome": "^0.2.7",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@vitest/coverage-v8": "^4.1.11",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "catalog:",
    "eslint-plugin-turbo": "^2.10.11",
    "jsdom": "^30.0.1",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  },
  "prettier": "@amibeingpwned/prettier-config"
}
